# Google AI Studio API key for Gemini (Required for AI search and game concept generation)
# Get a key at: https://aistudio.google.com/
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# RAWG.io API key (Required for real game cover images, ratings, and metadata)
# Get a free key at: https://rawg.io/apidocs
NEXT_PUBLIC_RAWG_API_KEY=your_rawg_api_key_here

# Optional — Firebase Auth and database credentials (if enabled)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
